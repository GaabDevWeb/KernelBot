# =============================================================================
# ACL (KernelBot) — variáveis de ambiente
# Copie para .env e preencha os valores reais:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# O ficheiro .env não deve ir para o Git (.gitignore).
# =============================================================================

# --- Auth de canal (adapters → Kernel) ---
# Em KERNELBOT_ENV=production é OBRIGATÓRIO (fail-fast no boot).
# Token global para Authorization: Bearer em /chat e /search.
# ACL_API_BEARER_TOKEN=
# Ou tokens por canal: discord:tok1,telegram:tok2,moodle:tok3
# ACL_CHANNEL_API_KEYS=
# auto (default) = true em production; force: true|false
# ACL_REQUIRE_API_AUTH=auto
# Proxies confiáveis para honrar X-Forwarded-For (CSV de IPs)
# ACL_TRUSTED_PROXY_IPS=127.0.0.1
# Snippet máximo em /search (default 200)
# ACL_SEARCH_SNIPPET_CHARS=200
# Preview de mensagem em traces (default 400, max 800)
# ACL_TRACE_MESSAGE_PREVIEW_CHARS=400
# Disciplina inválida não faz merge global (default true em production)
# ACL_DISCIPLINE_FAIL_CLOSED=

# --- Observabilidade interna (/internal/*) ---
# OBRIGATÓRIO e DISTINTO do reload em production.
# ACL_INTERNAL_BEARER_TOKEN=
# Guardar prompts no ring buffer em RAM (default false). Ligar só em debug: true
# ACL_INTERNAL_STORE_PROMPTS=false
# OpenAPI/Swagger: em production fica off. Em dev: ACL_ENABLE_DOCS=false para desligar.
# ACL_ENABLE_DOCS=
# TRACE operacional (SQLite + painel /traces) — default data/traces.sqlite3
# ACL_TRACE_ENABLED=true
# ACL_TRACE_DB_PATH=data/traces.sqlite3
# ACL_TRACE_RETENTION_DAYS=30
# Guardar prompts completos no snapshot (redacted). Default true.
# ACL_TRACE_STORE_PROMPTS=true

# --- Comunicações (campanhas via adapters) ---
# ACL_COMM_DB_PATH=data/comms.sqlite3
# ACL_COMM_ATTACHMENTS_DIR=data/comms/attachments
# JID/número do operador para «Enviar Teste»
# ACL_COMM_OPERATOR_JID=5511999999999
# URL do Orbit internal outbound (default 127.0.0.1:8010)
# ORBIT_INTERNAL_URL=http://127.0.0.1:8010

# --- Usuários Ops (sessões + bloqueios) ---
# ACL_USERS_DB_PATH=data/users.sqlite3

# --- Lab Ops (Playground / Benchmark) ---
# Modelos A/B/C para /ops/lab/benchmark (CSV). Sem isto, usa settings.models ou cursor_model.
# ACL_LAB_BENCHMARK_MODELS=openrouter/free,deepseek/deepseek-v4-flash,meta-llama/llama-4-maverick

# --- Provider LLM (OpenRouter ou Cursor SDK) ---
# cursor (default): usa Cursor Python SDK (cursor-sdk) com runtime local
# openrouter: usa OpenRouter chat completions (httpx)
ACL_LLM_PROVIDER=cursor

# --- OpenRouter (obrigatório se ACL_LLM_PROVIDER=openrouter) ---
# Chave da API em https://openrouter.ai/keys — usada em todas as chamadas ao LLM.
OPENROUTER_API_KEY=

# --- Cursor SDK (obrigatório se ACL_LLM_PROVIDER=cursor) ---
# Chave da API no Cursor Dashboard -> API Keys.
CURSOR_API_KEY=
# Modelo do Cursor SDK (ex.: composer-2.5). Para delegar o default ao servidor: auto.
ACL_CURSOR_MODEL=composer-2.5
# Default true (seguro): workspace vazio .cursor-chat-workspace. false = cwd do repo (risco).
ACL_CURSOR_CHAT_ONLY=true

# --- MySQL (obrigatório para o índice BM25 e ingestão) ---
# Host do servidor MySQL (ex.: 127.0.0.1 ou localhost). Nao use 127.0.0.0 — costuma dar timeout.
DB_HOST=
# Porta TCP (padrão MySQL: 3306).
DB_PORT=3306
# Nome da base de dados onde está a tabela `knowledge`.
DB_NAME=
# Utilizador com permissão de leitura (e escrita se correres ingest).
DB_USER=
DB_PASSWORD=

# --- Contexto global (/content sem disciplina) ---
# geral = BM25 em todos os silos e merge por score.
# all   = mesmo modo de nome alternativo aceite pelo código.
ACL_GLOBAL_CONTEXT=geral

# --- Histórico de conversa no prompt (POC — localStorage no browser) ---
# Máximo de mensagens user/assistant injetadas no LLM por turno.
ACL_CHAT_HISTORY_MAX_TURNS=12
# Máximo de caracteres totais do history no prompt (exclui system RAG).
ACL_CHAT_HISTORY_MAX_CHARS=12000

# --- Transcript store v1 (Kernel↔Orbit — POST /v1/chat) ---
# Quantos pares user/assistant manter por chave platform:user_id:channel_id[:session_id]
# (janela deslizante in-memory, não durável). Clamp 1-100.
ACL_TRANSCRIPT_MAX_TURNS=16

# --- Contexto fixado (pin na sessão) ---
# Quantos turnos manter chunks fixados antes de voltar a buscar forte.
ACL_PINNED_MAX_TURNS=5
# Tamanho máximo em caracteres do texto fixado no pin.
ACL_PINNED_MAX_CHARS=24000
# Score normalizado abaixo do qual o pin é considerado "fraco" (legado / heurísticas de pin).
ACL_PINNED_WEAK_SCORE=0.4

# --- Política de retrieval (modo strict — ver engine/retrieval.py) ---
# Score BM25 bruto mínimo do melhor candidato; abaixo → hard stop (contexto insuficiente).
ACL_RETRIEVAL_MIN_SCORE=1.5
# Margem mínima entre 1.º e 2.º score; evita ambos muito próximos (ambiguidade).
ACL_RETRIEVAL_MIN_SCORE_MARGIN=0.15
# Cobertura mínima (0–1) dos termos informativos da query nos chunks escolhidos.
ACL_RETRIEVAL_MIN_COVERAGE=0.34
# Igual, mas termos "centrais" da query contam com peso 2× na métrica.
ACL_RETRIEVAL_MIN_COVERAGE_WEIGHTED=0.34
# Número mínimo de termos informativos na pergunta (strict).
ACL_RETRIEVAL_MIN_TERMS=2
# Quantos candidatos o SearchEngine devolve antes de build_decision (1–50).
ACL_RETRIEVAL_CANDIDATE_K=8
# Quantos chunks entram no prompt após passar os gates (1–20).
ACL_RETRIEVAL_TOP_K=4
# Máximo de chunks por fonte (slug) entre os selecionados — diversidade (1–10).
ACL_RETRIEVAL_MAX_CHUNKS_PER_SOURCE=2
# --- Política de grounding (contrato injectado no prompt) ---
# strict   = trechos RAG são SSOT absoluto (comportamento conservador)
# anchored = trechos são evidência primária + extensão pedagógica rotulada (default)
# hybrid   = anchored com chunks; permissive sem chunks em retrieval fraco
ACL_GROUNDING_POLICY=anchored

# Legado (ignorado): gates de retrieval são só classificação (reason/confidence).
# Toda mensagem dispara o LLM; chunks fracos seguem ACL_GROUNDING_POLICY.
# ACL_RETRIEVAL_MODE=strict
# Com true, ambiguous_retrieval com ≥2 candidatos acima do MIN_SCORE gera LLM
# com grounding_disambiguation e fontes numeradas [Fonte 1], [Fonte 2], …
ACL_DISAMBIGUATION_ENABLED=false

# --- Catálogo lexical de aulas (ISS JSON — ver engine/lesson_catalog.py) ---
# Ativa roteamento por catálogo sem LLM (rescue, sugestões em hard stop).
ACL_CATALOG_ENABLED=false
# Diretório com lessons.json e search-index.json (vazio = ../ISS/content se existir).
# ACL_CATALOG_JSON_DIR=/caminho/para/ISS/content
# Score BM25 do catálogo mínimo para is_confident() (rescue / sugestões).
ACL_CATALOG_MIN_SCORE=2.0
# Margem mínima entre 1.º e 2.º match do catálogo.
ACL_CATALOG_MIN_MARGIN=0.35
# Limiar alto para is_strict_confident() — pré-escopo BM25 em fase futura (não relaxa retrieval).
ACL_CATALOG_STRICT_THRESHOLD=4.0
# Quantos matches do catálogo retornar em match().
ACL_CATALOG_PROMPT_TOP_K=5

# --- Rate limit (api/rate_limit.py + api/security.py) ---
# Defaults: /chat 30/min, /search 20/min, /groups 60/min, /internal 60/min (por IP + canal/user quando aplicável)
# ACL_CHAT_RATE_LIMIT=30
# ACL_SEARCH_RATE_LIMIT=20
# ACL_GROUPS_RATE_LIMIT=60
# ACL_INTERNAL_RATE_LIMIT=60
# ACL_AUTH_FAIL_RATE_LIMIT=10

# --- Idempotência (POST /v1/chat — header X-Message-Id ou metadata.message_id) ---
# KERNEL_IDEMPOTENCY_ENABLED=true
# KERNEL_IDEMPOTENCY_TTL_SECONDS=300

# --- Deploy V1 (single-worker) ---
# OBRIGATÓRIO: 1 em production (fail-fast se >1)
# KERNEL_WORKERS=1
# Bind recomendado em VPS (fail-fast warning se 0.0.0.0 em production)
# KERNEL_BIND_HOST=127.0.0.1

# --- Ambiente de execução ---
# development (default) | staging | production
# Em production: exige ACL_API_BEARER_TOKEN (ou CHANNEL keys) + ACL_INTERNAL_BEARER_TOKEN
# distinto; docs OpenAPI off; disciplina fail-closed on; use KERNELBOT_FORCE_HSTS=true atrás de HTTPS.
KERNELBOT_ENV=development
# staging → auth de canal obrigatória (como production)
# production → fail-fast tokens + single worker

# --- Reload / health CI (Bearer) ---
# Obrigatório em KERNELBOT_ENV=production para GET /health/catalog e POST /chat "/reload".
# Em staging/local pode ficar vazio — /health/catalog retorna 503 (comportamento esperado).
# O workflow ISS sync-kernelbot-knowledge envia o mesmo valor em KERNELBOT_RELOAD_TOKEN.
# NÃO reutilizar como ACL_INTERNAL_BEARER_TOKEN em production.
ACL_RELOAD_BEARER_TOKEN=

# --- ISS (links de fonte no frontend) ---
# Base da página de aula no ISS; o frontend monta ?d=<disciplina>&a=<slug>
# KERNELBOT_ISS_PUBLIC_BASE_URL=https://gaabdevweb.github.io/ISS/public/aula.html

# --- HTTPS / proxy reverso ---
# KERNELBOT_FORCE_HSTS=true

# --- Contexto em camadas (identidade / institucional / temporal / calendar) ---
# Ver docs/CONTEXT-ARCHITECTURE.md e context/context.md (template operacional).
# Timezone IANA do servidor — usado no contexto temporal e nos cálculos de datas.
# KERNEL_TIMEZONE=America/Sao_Paulo
# Diretório dos ficheiros institucionais (identity.md, faculty.md, professors.md,
# disciplines.md, rules.md). Default: <repo>/context
# KERNEL_CONTEXT_DIR=context
# Ficheiro JSON da agenda acadêmica. Default: <KERNEL_CONTEXT_DIR>/calendar.json
# KERNEL_CALENDAR_PATH=context/calendar.json
# ContextRouter FAST|NORMAL|DEEP (docs/contracts/context-route-v1.md).
# Default off = comportamento legado (institutional+calendar always-on).
# ACL_CONTEXT_ROUTER=0
# ACL_CONTEXT_ROUTER=1

# --- Group Memory (histórico privado por canal — SQLite + BM25) ---
# KERNEL_GROUP_MEMORY_ENABLED=true
# KERNEL_GROUP_MEMORY_DB_PATH=data/group_memory.sqlite3
# KERNEL_GROUP_MEMORY_MAX_RESULTS=5
# KERNEL_GROUP_MEMORY_RECENCY_WEIGHT=0.3
# KERNEL_GROUP_MEMORY_MAX_CHARS=4000
# KERNEL_GROUP_MEMORY_RETENTION_DAYS=0
# KERNEL_GROUP_PROFILE_ENABLED=true
# KERNEL_GROUP_PROFILE_UPDATE_THRESHOLD=50
# Import CLI (runtime, dados privados): python -m kernel.memory.import_history --file /path/export.txt --channel-id GROUP@g.us

# --- Logging ---
# text = linha legivel; json = uma linha JSON por evento ACL (grep/agregadores).
# ACL_LOG_FORMAT=text
# ACL_LOG_LEVEL=INFO
# ACL_LOG_LEVEL=DEBUG  # inclui evento retrieval_gates_inputs (metricas antes dos cortes)

# --- Não configurável por .env (definido em core/config.py) ---
# Lista de modelos OpenRouter, URL base, timeout HTTP, textos de system/sticky vêm de ficheiros
# em core/systemPrompt/ — ajusta lá ou no código se precisares de outro stack de modelos.
